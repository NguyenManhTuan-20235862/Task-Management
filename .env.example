# Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.

# Postgres chạy trong Docker (xem docker-compose.yml)
DATABASE_URL="postgresql://taskmgmt:taskmgmt@localhost:5432/taskmgmt?schema=public"

# Auth.js — sinh bằng: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Upload
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"

# Tài khoản admin cho seed script (vì hệ thống không có đăng ký)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
