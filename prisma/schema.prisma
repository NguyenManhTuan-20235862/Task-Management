// Nguồn sự thật duy nhất về data model — CLAUDE.md không copy schema này.
// Các ràng buộc Prisma KHÔNG enforce được (phải check ở Zod + Server Action):
//   - Task.assignee phải có User.role = DEV và là thành viên của project chứa task
//   - Task.progress trong khoảng 0..100; startDate <= dueDate
//   - PM là thành viên tối đa 2 project (đếm + chèn trong cùng transaction)
//   - Attachment thuộc đúng 1 trong 2: taskId XOR commentId
//     (bổ sung CHECK constraint bằng SQL trong migration đầu tiên)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PM
  DEV
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String // bcrypt — KHÔNG bao giờ lưu plaintext hay log ra
  name            String
  role            Role // role toàn cục — ProjectMember không có role riêng
  memberships     ProjectMember[]
  createdProjects Project[]       @relation("projectCreator")
  assignedTasks   Task[]          @relation("assignee")
  comments        Comment[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
}

model Project {
  id        String          @id @default(cuid())
  name      String
  creator   User            @relation("projectCreator", fields: [createdBy], references: [id])
  createdBy String // luôn là ADMIN
  members   ProjectMember[]
  tasks     Task[]
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
}

// Bảng nối: quyết định ai thấy project nào. Quyền hạn lấy từ User.role toàn cục.
model ProjectMember {
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String       @db.Text
  // Chỉ lưu ngày (không giờ) — nghiệp vụ tính theo ngày, tránh lệch timezone
  startDate   DateTime     @db.Date
  dueDate     DateTime     @db.Date
  assignee    User         @relation("assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assigneeId  String
  progress    Int          @default(0) // 0..100; 100 => DONE, 1..99 => IN_PROGRESS
  status      TaskStatus   @default(TODO)
  attachments Attachment[]
  comments    Comment[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([assigneeId])
}

model Comment {
  id          String       @id @default(cuid())
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId    String
  body        String       @db.Text
  attachments Attachment[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([taskId])
}

// Đính kèm cho task HOẶC comment — đúng 1 trong 2 khoá ngoại khác null (XOR)
model Attachment {
  id         String   @id @default(cuid())
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String?
  fileName   String // tên gốc — chỉ để hiển thị
  mimeType   String
  size       Int // bytes, tối đa 10MB — check ở route upload
  storageKey String   @unique // key ngẫu nhiên trên disk/S3 — không expose ra client
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([taskId])
  @@index([commentId])
}
